# Copy this file to bot/.env for local testing, or set these as Replit Secrets.
# Never commit real values. See bot/README.md.

# Required — bot token from https://discord.com/developers/applications → Bot
DISCORD_TOKEN=

# Required — Application ID (Developer Portal → General Information)
CLIENT_ID=

# Optional — your team server ID. Set it for instant command registration on that server.
GUILD_ID=

# Required — The Blue Alliance API key (thebluealliance.com → Account →
# Authentication Keys → create one). Validates the rotating 4-digit code.
TBA_AUTH_KEY=

# Recommended — IANA timezone for practice-day boundaries (sign-ins and stats).
# Defaults to the host timezone when unset. Example: America/Chicago
TZ=

# Optional — channel ID where a public "X signed in" message is posted after a sign-in.
SIGNIN_LOG_CHANNEL_ID=

# Optional — override the links store path (default bot/data/links.json)
LINKS_FILE=

# Optional — override the roster CSV path (default data/roster.csv at the repo root)
ROSTER_CSV=

# Optional — set to 1 to serve the display API without logging in to Discord
# (local testing: no DISCORD_TOKEN/CLIENT_ID required). PORT defaults to 3000.
WEB_ONLY=

# Optional — HTTP port for the display API (default 3000; Replit sets this for you)
PORT=

# Copy this file to bot/.env for local testing, or set these as Replit Secrets.
# Never commit real values. See bot/README.md.

# Required — bot token from https://discord.com/developers/applications → Bot
DISCORD_TOKEN=

# Required — Application ID (Developer Portal → General Information)
CLIENT_ID=

# Optional — your team server ID. Set it for instant command registration on that server.
GUILD_ID=

# Required — your deployed Apps Script /exec URL (the SAME one as site/config.js).
APPS_SCRIPT_URL=

# Optional — channel ID where a public "X signed in" message is posted after a sign-in.
SIGNIN_LOG_CHANNEL_ID=

# Optional — override the links store path (default bot/data/links.json)
LINKS_FILE=

# Copy this file to service/.env for local testing, or set these as service
# environment variables. Never commit real values.

# Required for the Discord bot connector. The bot sends this in X-Bot-Key.
# If unset, /api/link and /api/signin are disabled (the public display still works).
BOT_API_KEY=

# Required — The Blue Alliance API key (thebluealliance.com → Account →
# Authentication Keys → create one). Validates the rotating 4-digit code.
TBA_AUTH_KEY=

# Recommended — IANA timezone for practice-day boundaries (sign-ins and stats).
# Defaults to the host timezone when unset. Example: America/Chicago
TZ=

# Optional — HTTP bind address. Default 127.0.0.1 (safe when a tunnel or the
# bot runs on the same machine). Use 0.0.0.0 only if you intentionally expose
# the port directly.
HOST=

# Optional — HTTP port for the API (default 3000).
PORT=

# Optional — override the links store path (default service/data/links.json)
LINKS_FILE=

# Optional — override the roster CSV path (default data/roster.csv at the repo root)
ROSTER_CSV=

# Optional — shared token for the non-Discord kiosk page. If unset, the kiosk is disabled.
KIOSK_TOKEN=

# Optional — override the kiosk PIN store path (default service/data/pins.json)
PINS_FILE=

# Optional — Google Apps Script webhook for syncing sign-ins to Google Sheets.
# Deploy service/google-apps-script/Code.gs as a web app, then paste its URL here.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
SHEETS_SYNC_INTERVAL_MS=60000
